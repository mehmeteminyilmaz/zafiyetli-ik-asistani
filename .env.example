# Google Gemini API Anahtarı (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=buraya_api_anahtarinizi_yazin

# Model yapılandırması (tek doğruluk kaynağı: config.py)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2

# Sunucu ayarları (Güvenlik uyarısı: Kimlik doğrulaması yoktur, dış ağa 0.0.0.0 ile açmayın!)
HOST=127.0.0.1
PORT=8000
UVICORN_RELOAD=false
TRUST_PROXY_HEADERS=false

# Güvenlik, oturum ve hız sınırları
MAX_MESSAGE_LENGTH=1000
MAX_HISTORY_TURNS=10
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=512
CHAT_RATE_LIMIT_PER_MINUTE=20
SCAN_RATE_LIMIT_PER_5MIN=2
SCAN_TIMEOUT_SECONDS=600
SCAN_REQUEST_DELAY_SECONDS=1.2

# Web arayüzünden Giskard taraması ve model dışı (RBAC) yönetici uç noktası anahtarları
ENABLE_SCAN_ENDPOINT=true
SCAN_TOKEN=
ADMIN_API_TOKEN=
